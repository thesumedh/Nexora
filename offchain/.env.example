# ==============================================
# Nexora — Environment Configuration
# ==============================================

# Google AI Studio API Key (Required for AI Agent)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_API_KEY=your_api_key_here

# Agent Wallet Private Key (Optional — for on-chain settlement)
# This wallet submits transactions to the ComputeRouter contract
# and processes payments from users (User -> Agent -> Escrow)
# Must be funded with testnet tokens for gas
AGENT_PRIVATE_KEY=0x...

# Agent Model Configuration (Optional)
AGENT_MODEL=gemini-2.0-flash
AGENT_NAME=NexoraRoutingAgent

# Contract Addresses (Optional — defaults are set in code)
# COMPUTE_ROUTER_ADDRESS=0x...
# ESCROW_CONTRACT_ADDRESS=0x...
# TESTNET_USDC_CONTRACT=0x...

# Testnet RPC URL (Optional — default is set in code)
# TESTNET_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
